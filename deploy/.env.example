# Copy this file to .env and fill in your own values:  cp .env.example .env
# .env is git-ignored; never commit real passwords.

# ArboDat+ release version to run, e.g 1.0.0 (see https://github.com/cau-kiel-ai/arbodat_plus/releases)
ARBODAT_VERSION=

# Choose a strong password. Only applied the first time the database volume is initialised;
# changing it later does not change the password inside PostgreSQL (see README.md).
DATABASE_PASSWORD=

# Optional. Defaults shown below; uncomment to override.
# ARBODAT_PORT=8480
# ARBODAT_BIND=127.0.0.1
