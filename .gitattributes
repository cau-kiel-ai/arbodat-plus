# Force LF line endings for files that are executed or parsed inside Linux
# containers, regardless of the contributor's OS or core.autocrlf setting.
# (CRLF breaks shell scripts and adds a trailing \r to values in .env files.)
*.sh        text eol=lf
gradlew     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
*.template  text eol=lf
.env*       text eol=lf
