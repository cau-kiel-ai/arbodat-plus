# ArboDat+ frontend: static files + reverse proxy for the web-api and Nominatim.
#
# The official nginx image renders this template into /etc/nginx/conf.d/default.conf at startup
# (envsubst, only for variables defined in the environment, so nginx's own $vars are untouched).
# NGINX_LOCAL_RESOLVERS is provided by the image when NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1;
# inside Docker it is the embedded DNS server 127.0.0.11.
#
# Frontend code calls relative URLs ("api/...", "nominatim-reverse"), so the same image works
# on http://127.0.0.1:8480 (desktop app) and behind a server's reverse proxy, even under a sub-path.

resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

upstream web_api {
    zone web_api 64k;
    # "resolve": looked up at runtime, so nginx starts even while web-api is down
    # and follows its new IP address after the container is recreated.
    server web-api:8080 resolve;
    keepalive 8;
}

server {
    listen 80;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Data migration uploads two MS Access files (the web-api accepts up to 250 MB per request).
    client_max_body_size 260m;

    gzip on;
    gzip_types text/css application/javascript application/json text/plain image/svg+xml;

    # Liveness check for Docker / the desktop app (does not touch the web-api).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Static pages. Files are not fingerprinted, so browsers must revalidate after an update.
    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache" always;
    }

    # REST API: /api/sites -> http://web-api:8080/sites
    location /api/ {
        proxy_pass http://web_api/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Stream large uploads (migration) and the gzip data export instead of buffering them.
        proxy_request_buffering off;
        proxy_buffering off;

        proxy_connect_timeout 5s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
    }

    # Reverse geocoding (replaces the former Node.js proxy). Nominatim's usage policy requires an
    # identifying User-Agent, which browsers cannot set themselves.
    location = /nominatim-reverse {
        if ($arg_lat !~ "^-?[0-9]{1,3}(\.[0-9]+)?$") { return 400; }
        if ($arg_lon !~ "^-?[0-9]{1,3}(\.[0-9]+)?$") { return 400; }

        # A variable makes nginx resolve the host per request, so startup works offline.
        set $nominatim_host nominatim.openstreetmap.org;
        proxy_pass https://$nominatim_host/reverse?format=json&lat=$arg_lat&lon=$arg_lon;

        proxy_ssl_server_name on;
        proxy_ssl_name nominatim.openstreetmap.org;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;   # default 1 is too short for chains with an intermediate CA
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

        proxy_set_header Host nominatim.openstreetmap.org;
        proxy_set_header User-Agent "arbodat-plus (mail@arbodat.info)";
        # Same request as the old Node proxy sent: no browser cookies, referrer or language.
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_set_header Accept-Language "";

        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
    }
}
