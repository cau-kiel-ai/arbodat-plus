# Local development settings for docker-compose.yml
# Copy this file to .env:  cp .env.example .env
# (.env is git-ignored; never commit real passwords.)
#
# Note: PostgreSQL only applies this password when the database directory
# (./database/data) is initialised for the first time.
DATABASE_PASSWORD=password

# Optional. Defaults shown below; uncomment to override.
# ARBODAT_PORT=8480
# ARBODAT_WEB_API_PORT=8080
